# ---- Anhy Clips settings. Copy this file to .env and fill it in. Never commit .env. ----
#
# On your own computer you need nothing here: start Anhy Clips, open it, and add your AI key under Settings, AI.
# This file is for servers, and for anyone who prefers to keep settings in a file.
#
# A .env written before the app was called Anhy Clips keeps working as it is: every setting below still answers to
# its old PEAKCUT_ name (PEAKCUT_DATA, PEAKCUT_PORT, and so on). Where both names are set, the ANHY_ one wins.

# ================================================================ AI: bring your own key
# The easy way is the dashboard: Settings, AI. Whatever is saved there is used instead of these lines.
# Anhy Clips uses an AI model to pick the moments worth clipping and to write hooks, titles and captions.
# You choose the service and pay that service directly; Anhy Clips adds nothing on top.
# Without a key Anhy Clips still works: clips are then picked by loudness only, with no titles.
#
#   provider     where to get a key                          example model ids (check the provider's current list)
#   arena        https://platform.arena.ai/dashboard/keys     coding-router-preview (or an available direct model)
#   gemini       https://aistudio.google.com/apikey           gemini-2.5-flash
#   openai       https://platform.openai.com/api-keys         gpt-4o-mini
#   xai          https://console.x.ai                         grok-4            (Grok)
#   groq         https://console.groq.com/keys                llama-3.3-70b-versatile
#   openrouter   https://openrouter.ai/keys                   any model id listed there
#   anthropic    https://console.anthropic.com                a current Claude model id
#   ollama       no key: a model running on this machine      llama3.1          (ollama pull llama3.1)
#   custom       any service that speaks the OpenAI chat format: also set ANHY_AI_BASE_URL
ANHY_AI_PROVIDER=arena
# Arena's router is tuned for coding; a direct model available to your key may work better for clips.
ANHY_AI_MODELS=coding-router-preview
ANHY_AI_KEY=
# ANHY_AI_KEY_FILE=/secrets/ai.txt        # instead of ANHY_AI_KEY: a file that holds the key
# ANHY_AI_BASE_URL=                       # only for "custom", e.g. http://127.0.0.1:1234/v1
# ANHY_AI_MODELS takes several ids separated by commas. They are tried in order, so the second is a fallback.

# ================================================================ on a server (Docker): see DEPLOY.md
# Your domain (DNS must already point at this server) and a database password you make up.
# ANHY_DOMAIN=anhy.example.com
# POSTGRES_PASSWORD=change-me-to-a-long-random-string

# A server Anhy Clips has to itself: keep this line, and Anhy Clips fetches its own HTTPS certificate.
# A server that already runs a web server for other sites: leave it out and see deploy/nginx-anhy.conf.
# COMPOSE_PROFILES=own-https
# Behind Cloudflare's CDN: put the Cloudflare origin certificate in ./secrets as cloudflare-origin.crt and
# cloudflare-origin.key, and use the Caddyfile that serves it.
# ANHY_CADDYFILE=Caddyfile.origin
# ANHY_BIND_PORT=8765           # the port Anhy Clips listens on inside the server, if 8765 is taken
# Behind a Traefik that is already on the server, use this instead of the own-https line:
# COMPOSE_FILE=docker-compose.yml:deploy/docker-compose.traefik.yml
# If the domain goes through Cloudflare's CDN (orange cloud), the visitor's real address comes in this header.
# It is only believed for connections that really come from Cloudflare.
# ANHY_CLIENT_IP_HEADER=CF-Connecting-IP

# On a server shared with other apps: keep Anhy Clips inside its own share.
# ANHY_MEM_LIMIT=2g             # most memory it may use (it is stopped, not the other apps, if it goes over)
# ANHY_CPUS=1.5                 # most processor cores it may use
# ANHY_CPU_SHARES=256           # its turn at the processor when the server is busy (1024 is normal)
# ANHY_OOM_SCORE_ADJ=900        # if the whole server runs out of memory, Anhy Clips is stopped first
# ANHY_DB_MEM_LIMIT=256m

# ================================================================ where things are kept (own computer)
# ANHY_DATA=./data              # videos, clips, the database file and the speech model
# ANHY_PORT=8765
# ANHY_PUBLIC_URL=http://127.0.0.1:8765     # the address people open; set it to https://your-domain on a server
# DATABASE_URL=                    # empty: a SQLite file in the data folder. Or postgresql+psycopg://user:pass@host/db

# ================================================================ sign-in
# Off by default: Anhy Clips opens straight into the dashboard, which is right for your own computer.
# On a server other people can reach, turn accounts on, or anyone who finds the address can use it and your AI key.
# (docker-compose.yml turns them on by itself.)
# ANHY_ACCOUNTS=1

# ================================================================ admins (only with accounts on)
# Admins are not set here. Every new account is a normal user. After you sign up, make yourself an admin:
#   python -m anhy.admin grant you@example.com                 (also: revoke, list)
#   docker compose exec app python -m anhy.admin grant you@example.com      (with Docker)
# The admin dashboard is then at /admin, and does not exist for anyone else.

# ================================================================ Google (optional)
# One "Web application" OAuth client, used for Sign in with Google and for connecting YouTube to post Shorts.
# Authorised redirect URIs:  https://YOUR-DOMAIN/auth/google/callback  and  https://YOUR-DOMAIN/oauth/youtube/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CLIENT_FILE=/secrets/google_client.json

# Instagram and TikTok: the apps people's accounts connect through (Connect buttons in Settings, Connected apps).
# These can also be pasted in the dashboard by an admin: Settings, Connected apps, Set up. Redirect addresses to
# register:  https://YOUR-DOMAIN/oauth/instagram/callback  and  https://YOUR-DOMAIN/oauth/tiktok/callback
# ANHY_IG_APP_ID=
# ANHY_IG_APP_SECRET=
# ANHY_TIKTOK_CLIENT_KEY=
# ANHY_TIKTOK_CLIENT_SECRET=

# Buffer: optional, and only for the one-click "Sign in with Buffer". People normally connect Buffer with their own
# API key from https://publish.buffer.com/settings/api, which needs nothing set here. Redirect address to register:
# https://YOUR-DOMAIN/oauth/buffer/callback
# ANHY_BUFFER_CLIENT_ID=
# ANHY_BUFFER_CLIENT_SECRET=

# ================================================================ email (optional)
# Any SMTP service. Without it, password-reset and confirmation links are printed in the server's output instead,
# which is enough on your own computer.
# ANHY_SMTP_HOST=
# ANHY_SMTP_PORT=587
# ANHY_SMTP_USER=
# ANHY_SMTP_PASSWORD=
# ANHY_SMTP_PASSWORD_FILE=/secrets/smtp.txt
# ANHY_MAIL_FROM=Anhy Clips <hello@your-domain.com>
# ANHY_VERIFY_EMAIL=1           # on a public site: people must confirm their email before clipping

# Shown on the privacy, terms and acceptable-use pages of a public site.
# ANHY_CONTACT_EMAIL=
# ANHY_LEGAL_NAME=
# ANHY_LEGAL_COUNTRY=

# ================================================================ limits (all optional)
# How many videos run at once is decided by how busy the machine really is, every second. These only set the edges:
# ANHY_JOB_WORKERS=8            # the most videos that may ever run at once (default: one per CPU core)
# ANHY_BUSY_CPU=82              # no extra video or recording starts while the processor is above this percent
# ANHY_MIN_FREE_RAM_GB=1.5      # ...or while less memory than this is free
# There are no limits unless you set one here: 0 (the default) means none. A server other people use may want some.
# ANHY_MAX_LIVE=8               # live recordings at once, whole server (default: twice the CPU cores; load decides below it)
# ANHY_MAX_LIVE_PER_USER=0      # streams one person records at once
# ANHY_MAX_JOBS_PER_USER=5      # videos one person sends and has worked on at once
# ANHY_MAX_UPLOAD_MB=0          # the largest video file someone may upload
# A video that is already in a folder on this computer can be clipped from there: no upload, no download, no copy.
# ANHY_LOCAL_PICK=1             # 0 turns the folder picker off (on a server with sign-in, only an admin sees it)
# ANHY_LOCAL_FOLDERS=           # folders to offer in it, separated by semicolons, e.g. D:\Streams;/mnt/recordings
# ANHY_UPLOAD_PART_MB=40        # big files are sent in pieces of this size (Cloudflare refuses requests over 100 MB)
# ANHY_MAX_VIDEO_HOURS=0        # longest video, or chosen part of one, that is processed
# ANHY_MAX_LIVE_HOURS=0         # a live recording stops by itself after this long
# ANHY_MAX_USER_GB=0            # disk space one account may use
# ANHY_MAX_CREATORS=0           # creators one account may add
# ANHY_FFMPEG_DIR=              # the folder that holds ffmpeg, if Anhy Clips cannot find it by itself
# ANHY_CLIP_MINUTES=15          # a clip that takes longer than this to make is stopped, so it cannot hold the video up
# ANHY_ALLOWED_SITES=youtube.com,youtu.be,twitch.tv,kick.com,hotstar.com,jiohotstar.com
# ANHY_HOTSTAR_COOKIES_FILE= # Optional private Netscape-format cookies.txt for JioHotstar videos requiring login
# ANHY_YT_TRANSCRIPT=1          # use YouTube's own transcript to find clips faster (0: always transcribe here)
# ANHY_UPDATE_CHECK=1          # look on GitHub once a minute for a newer Anhy Clips (0: never)

# ================================================================ speech to text on a graphics card (optional)
# Speech is transcribed on this machine's processor by default. A second machine with an NVIDIA card can take
# over most of it: see deploy/gpu/docker-compose.yml, then set these on the main server.
# ANHY_ASR_URL=http://10.0.0.2:9000
# ANHY_ASR_TOKEN=a-long-random-string-shared-by-both-machines
